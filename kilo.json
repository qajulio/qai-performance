{
  "$schema": "https://kilo.ai/schemas/kilo.json",
  "version": 1,
  "name": "qa-performance",
  "description": "Toolkit de QA para testes de performance, carga, stress e SLA usando k6 e JMeter, com agentes, skills, regras e MCPs de conexão.",
  "commands": [".kilo/commands/*.md"],
  "agents": [".kilo/agents/*.md"],
  "skills": [".kilo/skills/*.md"],
  "rules": [".kilo/rules/*.md"],
  "mcpServers": {
    "k6-gateway": {
      "type": "stdio",
      "command": "node",
      "args": ["./mcp/k6-mcp-server.cjs"],
      "env": {
        "K6_API_URL": "http://localhost:6565",
        "K6_OUT": "influxdb=http://localhost:8086/k6"
      }
    },
    "jmeter-bridge": {
      "type": "stdio",
      "command": "node",
      "args": ["./mcp/jmeter-mcp-server.cjs"],
      "env": {
        "JMETER_HOME": "C:/apache-jmeter-5.6.3",
        "JMETER_BIN": "C:/apache-jmeter-5.6.3/bin/jmeter"
      }
    },
    "grafana-observe": {
      "type": "http",
      "url": "http://localhost:3000/api/mcp",
      "headers": {
        "Authorization": "Bearer ${GRAFANA_TOKEN}"
      }
    }
  },
  "settings": {
    "performance": {
      "defaultTool": "k6",
      "defaultDuration": "5m",
      "defaultVUs": 50,
      "reportDir": "./reports",
      "thresholds": "./specs/sla-thresholds.json"
    }
  }
}
